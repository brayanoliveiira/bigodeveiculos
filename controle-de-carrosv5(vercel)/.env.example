# Copie para .env (docker compose lê automaticamente) ou exporte as variáveis antes de iniciar.

# Porta e endereço do servidor.
PORT=3000
HOST=0.0.0.0

# Onde fica o banco de dados (um único arquivo SQLite). Faça backup deste arquivo.
DB_PATH=./data/controle.db

# Primeira execução: cria o primeiro administrador se ainda não existir nenhum usuário.
# Depois que entrar, pode apagar ADMIN_PASSWORD daqui.
ADMIN_USER=brayan
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Brayan

# Atrás de HTTPS (recomendado em produção): true marca o cookie de login como Secure.
COOKIE_SECURE=false
# Atrás de proxy reverso (Nginx, Caddy, Cloudflare Tunnel...): true usa X-Forwarded-For para o IP real.
TRUST_PROXY=false

# Dias até a sessão expirar sem uso.
SESSION_DAYS=14

# Cópias de segurança (npm run backup)
BACKUP_KEEP=30

# Consulta de placa + FIPE no cadastro do carro (serviço pago de terceiros, ex.: apiplacas.com.br).
# Sem o token o botão "Consultar placa e FIPE" mostra um aviso e o resto do app funciona normal.
# Cada consulta é cobrada pelo provedor; o app guarda o resultado por 30 dias para não repetir.
PLACA_API_TOKEN=
# PLACA_API_URL=https://wdapi2.com.br/consulta

# Tabela FIPE gratuita (botão "Buscar valor na tabela FIPE"): funciona sem nada. 500 consultas/dia sem token;
# com um token gratuito de fipe.api.br/register sobe para 1.000/dia. O app guarda tudo em cache.
FIPE_TOKEN=

# ---- Nuvem (Vercel + Supabase) ----
# Com DATABASE_URL o app usa o PostgreSQL do Supabase em vez do arquivo local. Veja docs/DEPLOY-VERCEL-SUPABASE.md.
# Use a "Connection string" do modo Transaction pooler (porta 6543), com a senha do projeto.
# DATABASE_URL=postgresql://postgres.xxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Consulta por placa GRÁTIS via APIBrasil (100 consultas/dia): crie conta em app.apibrasil.io,
# "Minhas APIs" > "API Placa Dados", copie o BearerToken e o DeviceToken.
# APIBRASIL_BEARER=
# APIBRASIL_DEVICE_TOKEN=

# Consulta por placa pelo site tabelafipebrasil.com (padrão, sem token). false desliga.
# PLACA_SITE=true
